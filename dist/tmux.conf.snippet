# clipfan tmux integration
#
# Source this from your ~/.tmux.conf:  source-file ~/.config/clipfan/tmux.conf
# then reload:                         tmux source-file ~/.tmux.conf
#
# It rebinds copy-mode yanks to ALSO pipe the selection through `clipfan copy`,
# which injects into the local clipfan daemon (and emits OSC 52 as a fallback
# for terminals/clients that support it). Works for both vi and emacs copy mode.
#
# The absolute $HOME/.local/bin/clipfan path is deliberate: tmux runs copy-pipe
# commands via a non-login shell whose PATH may not include ~/.local/bin.

# vi copy-mode: y and Enter both copy-pipe to clipfan
bind -T copy-mode-vi y     send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/clipfan copy --osc52 #{client_tty}"
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/clipfan copy --osc52 #{client_tty}"
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/clipfan copy --osc52 #{client_tty}"

# emacs copy-mode (default): M-w and mouse drag copy-pipe to clipfan
bind -T copy-mode    M-w   send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/clipfan copy --osc52 #{client_tty}"
bind -T copy-mode    MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/clipfan copy --osc52 #{client_tty}"
