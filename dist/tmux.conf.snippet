# clipfan tmux integration
#
# Installed by dist/install.sh to ~/.config/clipfan/tmux.conf and sourced from
# ~/.tmux.conf. To wire it up by hand instead:
#     echo 'source-file ~/.config/clipfan/tmux.conf' >> ~/.tmux.conf
#     tmux source-file ~/.tmux.conf      # or restart tmux
#
# This makes copy-mode yanks flow into the clipfan daemon, which syncs them to
# the whole fleet. The bindings cover y / Enter / mouse drag in BOTH the vi and
# emacs copy-mode tables so it works whichever mode-keys resolves to.
#
# Each binding also emits OSC 52 to the client tty as a fallback for terminals
# that consume it (Blink/iTerm/Kitty/Ghostty; Apple Terminal ignores it).
#
# Absolute $HOME/.local/bin/clipfan is deliberate: tmux runs hook and copy-pipe
# commands in a non-login shell whose PATH usually omits ~/.local/bin.
#
# No secrets live here. The shared key is host-local in ~/.config/clipfan/config.json.

# --- copy-mode yanks ---------------------------------------------------------
# vi copy-mode
bind -T copy-mode-vi y     send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/clipfan copy --osc52 #{client_tty}"
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/clipfan copy --osc52 #{client_tty}"
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/clipfan copy --osc52 #{client_tty}"
# emacs copy-mode
bind -T copy-mode M-w   send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/clipfan copy --osc52 #{client_tty}"
bind -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/clipfan copy --osc52 #{client_tty}"
