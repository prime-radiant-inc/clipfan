# clipfan tmux integration — source this from your ~/.tmux.conf with:
#     source-file ~/.local/share/clipfan/tmux.conf.snippet
# (or copy these bindings into your existing config).
#
# This replaces any older OSC-52-only copy bindings. The single `clipfan copy
# --osc52 #{client_tty}` call does two things at once:
#   1) POSTs the yanked bytes to the local clipfan daemon, which broadcasts
#      them to every other host in your fleet.
#   2) Emits an OSC 52 escape to whichever tmux client is currently driving,
#      so a terminal connected from a non-clipfan host (e.g. Blink on your
#      phone, or kitty on a laptop without clipfan) still grabs the text.

# Copy-mode (vi) yanks
bind -T copy-mode-vi y           send-keys -X copy-pipe-and-cancel 'clipfan copy --osc52 #{client_tty}'
bind -T copy-mode-vi Enter       send-keys -X copy-pipe-and-cancel 'clipfan copy --osc52 #{client_tty}'
bind -T copy-mode-vi MouseDragEnd1Pane \
                                 send-keys -X copy-pipe-and-cancel 'clipfan copy --osc52 #{client_tty}'

# Optional: drop the now-redundant terminal-features / overrides if they were
# part of your previous OSC-52-only setup. Uncomment if your config had them:
# set -us terminal-features
# set -us set-clipboard
# set -ug allow-passthrough
